# Note: GitHub Pages ignores this file. The CSP is also set with a meta tag in Seo.astro.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://gc.zgo.at; connect-src 'self' https://api.github.com https://raw.githubusercontent.com https://vibelocked.goatcounter.com; img-src 'self' data: https://vibelocked.goatcounter.com https://thedevtoolsindex.com; style-src 'self' 'unsafe-inline'; font-src 'self'; form-action 'self' https://buttondown.com; base-uri 'self'; object-src 'none'; frame-ancestors 'none'

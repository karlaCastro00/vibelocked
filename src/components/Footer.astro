---
import { SITE } from '../lib/site';

const links = [
  { href: '/checklists', label: 'Checklists' },
  { href: '/guides', label: 'Guides' },
  { href: '/newsletter', label: 'Newsletter' },
  { href: '/sponsor', label: 'Sponsor' },
  { href: '/about', label: 'About' },
  { href: '/privacy', label: 'Privacy' },
  { href: '/rss.xml', label: 'RSS' },
  { href: '/llms.txt', label: 'llms.txt' },
];
---

<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>
      <p class="kicker">VibeLocked</p>
      <p class="footer-meta">
        Independent security notes for people who build apps with AI coding tools. Not affiliated with Lovable, Bolt, v0, Cursor, Replit, Supabase, Firebase, Stripe, or Vercel.
      </p>
    </div>
    <div>
      <ul class="footer-links">
        {links.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
      <p class="footer-meta">
        Sponsors: <a href={`mailto:${SITE.sponsorEmail}`}>{SITE.sponsorEmail}</a>
      </p>
      <p class="footer-meta footer-badge">
        <span>Listed on</span>
        <a href="https://thedevtoolsindex.com/product/vibelocked-scan?ref=badge" rel="dofollow"><img src="https://thedevtoolsindex.com/badge/vibelocked-scan.svg" alt="Featured on TheDevToolsIndex" width="182" height="46" loading="lazy" /></a>
      </p>
    </div>
  </div>
</footer>

<style>
  .footer-badge { display: flex; flex-direction: column; gap: 0.3rem; align-items: flex-start; }
  .footer-badge img { width: 137px; height: auto; opacity: 0.85; display: block; }
  .footer-badge a:hover img { opacity: 1; }
</style>

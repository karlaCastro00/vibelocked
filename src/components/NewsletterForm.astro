---
interface Props {
  id?: string;
  tone?: 'band' | 'page';
}

const { id = 'email', tone = 'band' } = Astro.props;
---

<form
  class:list={['signup', tone === 'page' && 'page-signup']}
  action="https://buttondown.com/api/emails/embed-subscribe/vibelocked"
  method="post"
  target="_blank"
>
  <label for={id}>Email</label>
  <div class="signup-row">
    <input id={id} name="email" type="email" required autocomplete="email" inputmode="email" placeholder="you@example.com" />
    <input type="hidden" name="embed" value="1" />
    <button type="submit">Join the list</button>
  </div>
  <p class="fine">
    Sent with <a href="https://buttondown.com" rel="noopener">Buttondown</a>. You will get a confirmation email first. Unsubscribe from any edition in one click.
  </p>
</form>

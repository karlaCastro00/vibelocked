---
import Base from '../layouts/Base.astro';

const description =
  'Free scanner for vibe coders. Find exposed OpenAI, Stripe, Supabase service role, AWS, and GitHub keys in a public GitHub repo. Runs in your browser.';

const jsonLd = {
  '@type': 'WebApplication',
  name: 'VibeLocked secret leak scanner',
  url: 'https://vibelocked.com/scan',
  applicationCategory: 'SecurityApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  description,
};
---

<Base title="Secret leak scanner" description={description} path="/scan" jsonLd={jsonLd}>
  <div class="wrap">
    <header class="page-intro">
      <p class="kicker">Free tool</p>
      <h1 class="page-title">Find leaked keys before someone else does</h1>
      <p class="lede">
        Check what the public can already see in your public GitHub repo. You never type a secret here. Everything runs in your browser and nothing is uploaded to VibeLocked.
      </p>
    </header>

    <section class="panel scan-panel" id="panel-repo">
      <form id="repo-form">
        <label for="repo-url"><strong>Public GitHub repo URL</strong></label>
        <div class="scan-actions">
          <input id="repo-url" type="text" inputmode="url" autocomplete="off" spellcheck="false" placeholder="https://github.com/you/your-app" required />
          <button class="button" type="submit" id="repo-run">Scan repo</button>
        </div>
      </form>
      <p class="scan-note">
        Needs nothing private: no login, no token. Your browser reads the repo from GitHub's public API and raw.githubusercontent.com, then checks up to 150 text files locally (skipping node_modules, lockfiles, binaries, and files over 200 KB). GitHub allows about 60 API calls per hour per network without login, and a scan uses three.
      </p>
      <p id="repo-status" class="scan-note" aria-live="polite"></p>
    </section>

    <div id="scan-results" class="scan-results" aria-live="polite"></div>

    <article class="prose">
      <h2>What it looks for</h2>
      <ul>
        <li>OpenAI, Anthropic, Google (Gemini, Maps), Groq, xAI, Replicate, Hugging Face tokens</li>
        <li>Stripe or Clerk secret and publishable keys, Stripe restricted keys, and Stripe or Clerk webhook signing secrets</li>
        <li>Supabase service role keys (legacy JWT with role service_role) and new sb_secret_ keys</li>
        <li>AWS access key IDs and secret keys, GitHub and GitLab tokens, Slack tokens and webhooks</li>
        <li>Twilio, SendGrid, Resend, Discord webhooks, private key blocks, and database URLs with a password</li>
        <li>Generic secret assignments, such as SECRET=, TOKEN=, or PASSWORD= with a long value</li>
      </ul>
      <p>
        Publishable values like a Stripe pk_ key, a Supabase anon key, or a Firebase web config are reported as safe to ship, so you can tell them apart from real secrets. See <a href="/guides/supabase-anon-key-vs-service-role-key">anon key vs service role key</a>.
      </p>
      <h2>If it finds a live secret</h2>
      <p>
        Rotate the key at the provider first, then remove it from code and <a href="/guides/remove-api-key-from-github-history">git history</a>. Deleting the line is not enough once it was pushed or deployed. Follow <a href="/guides/first-hour-after-an-api-key-leaks">the first hour after an API key leaks</a> and <a href="/guides/check-if-api-key-leaked-on-github">check your GitHub history</a>.
      </p>
      <h2>Limits</h2>
      <p>
        The repo scan reads the current branch only, not old commits, and stops at 150 files. Pattern matching misses keys with no fixed format and can flag test values. A clean result is not proof that a project is safe. For private repos and full history, run Gitleaks or TruffleHog on your own machine or in CI.
      </p>
    </article>
  </div>
</Base>

<style>
  .scan-panel { padding: 1.1rem 1.15rem; margin-top: 1rem; }
  .scan-panel input {
    flex: 1 1 18rem; min-width: 0;
    width: 100%; box-sizing: border-box; font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.85rem; padding: 0.75rem; border-radius: 6px; border: 1px solid currentColor; background: transparent; color: inherit;
  }
  .scan-actions { display: flex; gap: 0.6rem; align-items: center; flex-wrap: wrap; margin-top: 0.7rem; }
  .scan-note { font-size: 0.85rem; opacity: 0.75; }
  .scan-results { margin: 1.4rem 0; max-width: 52rem; }
  .scan-results :global(.finding) { border-left: 4px solid #c0392b; padding: 0.5rem 0.8rem; margin: 0.6rem 0; }
  .scan-results :global(.finding.info) { border-color: #2e8b57; }
  .scan-results :global(.finding.warn) { border-color: #d48806; }
  .scan-results :global(code) { word-break: break-all; }
  .scan-results :global(.sum) { font-weight: 600; }
  .scan-results :global(a) { word-break: break-all; }
</style>
<script>
  import { scanRepo, RepoScanError, type RepoFinding } from '../lib/repoScan';

  const out = document.getElementById('scan-results') as HTMLDivElement;
  const status = document.getElementById('repo-status') as HTMLParagraphElement;
  const runBtn = document.getElementById('repo-run') as HTMLButtonElement;

  function el(tag: string, cls: string, text: string) {
    const node = document.createElement(tag);
    if (cls) node.className = cls;
    node.textContent = text;
    return node;
  }

  function render(findings: RepoFinding[], summary: string) {
    out.replaceChildren(el('p', 'sum', summary));
    for (const f of findings) {
      const box = el('div', 'finding ' + f.level, '');
      const label = f.level === 'high' ? 'Secret' : f.level === 'warn' ? 'Review' : 'Public';
      const link = el('a', '', `${f.path}:${f.line}`) as HTMLAnchorElement;
      link.href = f.url; link.target = '_blank'; link.rel = 'noopener noreferrer';
      box.append(el('strong', '', `${label}: ${f.name} `), link, el('span', '', ' '), el('code', '', f.masked), el('p', '', f.fix));
      out.append(box);
    }
  }

  document.getElementById('repo-form')!.addEventListener('submit', async (e) => {
    e.preventDefault();
    const url = (document.getElementById('repo-url') as HTMLInputElement).value;
    out.replaceChildren();
    runBtn.disabled = true;
    status.textContent = 'Reading the file list from GitHub...';
    try {
      const r = await scanRepo(url, { onProgress: (d, t) => { status.textContent = `Scanned ${d} of ${t} files...`; } });
      const high = r.findings.filter((f) => f.level === 'high').length;
      const warn = r.findings.filter((f) => f.level === 'warn').length;
      status.textContent = `Done: ${r.repo} on ${r.branch}, ${r.scanned} file${r.scanned === 1 ? '' : 's'} checked${r.truncated ? ` (first ${r.scanned} of ${r.totalCandidates} text files, env and config files first)` : ''}.`;
      render(r.findings, r.findings.length === 0
        ? 'No known key formats found in the files checked. That is not a guarantee, and old commits were not checked.'
        : `${high} likely secret${high === 1 ? '' : 's'}, ${warn} to review, ${r.findings.length - high - warn} safe to ship. Values are partly masked.`);
    } catch (err) {
      status.textContent = err instanceof RepoScanError ? err.message : 'Something went wrong while scanning. Try again in a minute.';
    } finally {
      runBtn.disabled = false;
    }
  });
</script>

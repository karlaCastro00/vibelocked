---
import Base from '../../layouts/Base.astro';
import RuledList from '../../components/RuledList.astro';
import { publishedArticles } from '../../lib/articles';

const articles = (await publishedArticles()).filter((article) => article.data.category === 'checklist');
const description =
  'Launch checklists for Supabase RLS, Firebase rules, Lovable and Bolt apps, and the last pass before you share a URL.';
---

<Base title="Security checklists for AI-built apps" description={description} path="/checklists/">
  <div class="wrap">
    <header class="page-intro">
      <p class="kicker">Checklists</p>
      <h1 class="page-title">Checklists</h1>
      <p class="lede">
        Short enough to run before you send someone the link. Each one links to the longer guide when a step needs more than a checkbox.
      </p>
    </header>
    <RuledList articles={articles} />
  </div>
</Base>

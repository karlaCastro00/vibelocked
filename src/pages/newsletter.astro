---
import Base from '../layouts/Base.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import { SITE } from '../lib/site';

const description =
  'A VibeLocked security note every two weeks on leaks, security rules, and launch checks. Free, sent with Buttondown, double opt-in.';

const jsonLd = {
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Where is my email stored?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'With Buttondown, the email provider that sends the list. You confirm by email before anything is sent, and every edition has a one-click unsubscribe.',
      },
    },
    {
      '@type': 'Question',
      name: 'What will each edition include?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'One practical security note for people shipping AI-built apps: a rule change, a leak pattern, or a launch check, with links to official docs. It will not invent incident statistics.',
      },
    },
  ],
};
---

<Base title="Security notes every two weeks" description={description} path="/newsletter" jsonLd={jsonLd}>
  <div class="wrap">
    <header class="page-intro">
      <p class="kicker">Newsletter</p>
      <h1 class="page-title">A short note, every two weeks</h1>
      <p class="lede">
        For people about to share an AI-built app. One leak pattern, one rule worth checking, or one launch step, with a link to the vendor doc.
      </p>
    </header>
    <article class="prose">
      <h2>What you will get</h2>
      <ul>
        <li>Something you can check in your own project that week.</li>
        <li>Links to official docs, not a retelling of a breach we did not verify.</li>
        <li>A skipped edition when there is nothing worth sending. No padded editions.</li>
      </ul>
      <h2>What you will not get</h2>
      <ul>
        <li>A product pitch from VibeLocked. We have nothing to sell you, and the scanner is free.</li>
        <li>Unlabeled sponsor copy. If a future edition mentions a sponsor, the line will say so.</li>
        <li>Your address sold or shared. It stays with Buttondown and is used only for this list.</li>
      </ul>
      <h2>Read past editions</h2>
      <p>
        <a href="https://buttondown.com/vibelocked/archive/vibelocked-edition-1-the-keys-ai-tools-love-to/" rel="noopener">Edition 1: the keys AI tools love to leak</a> covers which keys belong in your frontend and which must stay on your server. Every edition is in the <a href="https://buttondown.com/vibelocked/archive/" rel="noopener">archive</a>.
      </p>
      <p>
        Questions about the list: <a href={`mailto:${SITE.helloEmail}`}>{SITE.helloEmail}</a>.
      </p>
    </article>
    <div class="panel" style="padding: 1.1rem 1.15rem; margin-top: 1.4rem; max-width: 40rem;">
      <h2 style="font-family: var(--serif); margin: 0 0 0.4rem;">Join the list</h2>
      <NewsletterForm id="newsletter-email" tone="page" />
    </div>
  </div>
</Base>
